<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>PhantomQoL</RootNamespace>
        <AssemblyName>PhantomQoL</AssemblyName>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <OutputPath>..\..\build\plugins\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <TerrariaPath>F:\Apps\Steam\steamapps\common\Terraria</TerrariaPath>
        <ModId>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\manifest.json')), '"id":\s*"([^"]+)"').Groups[1].Value)</ModId>
        <ModInstallPath>$(TerrariaPath)\TerrariaModder\mods\$(ModId)</ModInstallPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Terraria">
            <HintPath>$(TerrariaPath)\Terraria.exe</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="TerrariaModder.Core">
            <HintPath>$(TerrariaPath)\TerrariaModder\core\TerrariaModder.Core.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(TerrariaPath)\TerrariaModder\core\deps\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Microsoft.Xna.Framework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=842cf8be1de50553">
            <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Microsoft.Xna.Framework.Graphics, Version=4.0.0.0, Culture=neutral, PublicKeyToken=842cf8be1de50553">
            <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Microsoft.Xna.Framework.Game, Version=4.0.0.0, Culture=neutral, PublicKeyToken=842cf8be1de50553">
            <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ModAssets Include="**\*.png"/>
    </ItemGroup>

    <Target Name="PackageRelease" AfterTargets="Build">
        <PropertyGroup>
            <ReleasesPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'releases'))</ReleasesPath>
            <StagingPath>$(ReleasesPath)\_staging\$(ModId)</StagingPath>
            <ZipPath>$(ReleasesPath)\$(ModId).zip</ZipPath>
        </PropertyGroup>
        <RemoveDir Directories="$(StagingPath)" Condition="Exists('$(StagingPath)')"/>
        <MakeDir Directories="$(StagingPath)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingPath)"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.json" DestinationFolder="$(StagingPath)"/>
        <MakeDir Directories="@(ModAssets->'$(StagingPath)\%(RelativeDir)')"/>
        <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(StagingPath)\%(Identity)')"/>
        <Exec Command="powershell -NoProfile -Command &quot;Remove-Item -LiteralPath '$(ZipPath)' -Force -ErrorAction SilentlyContinue; Compress-Archive -Path '$(StagingPath)' -DestinationPath '$(ZipPath)'&quot;"/>
        <RemoveDir Directories="$(ReleasesPath)\_staging"/>
        <Message Text="Release packaged: $(ZipPath)" Importance="high"/>
    </Target>

    <Target Name="DeployToModFolder" AfterTargets="Build">
        <MakeDir Directories="$(ModInstallPath)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallPath)"/>
        <Copy SourceFiles="$(MSBuildProjectDirectory)\manifest.json" DestinationFolder="$(ModInstallPath)"/>
        <MakeDir Directories="@(ModAssets->'$(ModInstallPath)\%(RelativeDir)')"/>
        <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(ModInstallPath)\%(Identity)')"/>
    </Target>
</Project>